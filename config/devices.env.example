# Android device / emulator settings for Appium (optional overrides)

# Emulator name from `adb devices` or Android Studio AVD
ANDROID_DEVICE_NAME=Android Emulator

# Omit to let Appium detect the OS version from the running device
# ANDROID_PLATFORM_VERSION=14

# SDK location (Gradle/adb); required for local Android tooling
# ANDROID_HOME=/Users/you/Library/Android/sdk
