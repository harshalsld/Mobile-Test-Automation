{
  "name": "mobile-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Appium + WebdriverIO framework for testing a bundled sample Android APK",
  "scripts": {
    "postinstall": "bash scripts/download-sample-apk.sh && npx appium driver install uiautomator2 || true",
    "app:download": "bash scripts/download-sample-apk.sh",
    "devices:list": "bash scripts/list-devices.sh",
    "test:android": "wdio run config/wdio.android.conf.ts",
    "test:android:spec": "wdio run config/wdio.android.conf.ts --spec",
    "appium:doctor": "npx appium driver doctor uiautomator2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@wdio/appium-service": "^9.4.0",
    "@wdio/cli": "^9.4.0",
    "@wdio/globals": "^9.4.0",
    "@wdio/local-runner": "^9.4.0",
    "@wdio/mocha-framework": "^9.4.0",
    "@wdio/spec-reporter": "^9.4.0",
    "appium": "^2.13.0",
    "appium-uiautomator2-driver": "^3.8.0",
    "expect-webdriverio": "^6.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">= 20"
  }
}
